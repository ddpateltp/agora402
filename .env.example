# Copy to .env and fill in. Never commit .env.
# Seller: your ECDSA testnet account from portal.hedera.com.
# Buyer: created for you by `npm run setup:buyer`, do not fill by hand.

HEDERA_NETWORK=testnet

# Seller: the account that receives payments and signs registry / receipt messages
SELLER_ACCOUNT_ID=0.0.xxxxx
SELLER_PRIVATE_KEY=0x...

# Buyer agent: the account that pays (written by npm run setup:buyer)
BUYER_ACCOUNT_ID=0.0.yyyyy
BUYER_PRIVATE_KEY=0x...

# x402 facilitator (Blocky402 hosted testnet, no API key needed)
FACILITATOR_URL=https://api.testnet.blocky402.com

# HCS topics (created by `npm run setup:topics`)
REGISTRY_TOPIC_ID=
RECEIPTS_TOPIC_ID=

# Trust layer topics (created by `npm run setup:trust`). Leave empty to run without audits and ratings.
AUDIT_TOPIC_ID=
REPUTATION_TOPIC_ID=

# Optional HTS settlement token (created by `npm run setup:token`). Leave empty for HBAR only.
TOLL_TOKEN_ID=

# Seller HTTP service
SELLER_PORT=4402
SELLER_PUBLIC_URL=http://localhost:4402
SELLER_NAME=agora-seller-1

# Role of the seller process: services (infer + hbar-rate) | auditor (paid audits only) | both
SELLER_ROLE=services
# Flat price of one audit in tinybars (1000000 = 0.01 HBAR)
AUDIT_PRICE_TINYBARS=1000000

# Auditor agent, a second seller process started with `npm run auditor` (account written by npm run setup:auditor)
AUDITOR_ACCOUNT_ID=
AUDITOR_PRIVATE_KEY=
AUDITOR_PORT=4404
AUDITOR_PUBLIC_URL=http://localhost:4404
AUDITOR_NAME=agora-auditor-1

# LLM provider for the paid inference service: groq | anthropic | mock
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Buyer dashboard
BUYER_PORT=4403
# Server-side caps in HBAR; a request body cannot raise the spend above these
BUYER_MAX_SESSION_HBAR=0.5
BUYER_MAX_CALL_HBAR=0.05
