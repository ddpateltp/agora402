{
  "name": "agora402",
  "version": "0.1.0",
  "private": true,
  "description": "Agora402: an agent-to-agent services marketplace on Hedera. Discover, negotiate and pay per request over x402, settled through Blocky402, with HCS receipts.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "scripts"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b packages/shared packages/registry packages/audit packages/seller packages/buyer scripts && npm run typecheck --workspace=packages/web",
    "test": "vitest run",
    "seller": "npm run dev --workspace=packages/seller",
    "buyer": "npm run cli --workspace=packages/buyer --",
    "dev": "concurrently --names seller,auditor,buyer-api,web --prefix-colors cyan,yellow,magenta,green \"npm run seller\" \"npm run auditor\" \"npm run dev --workspace=packages/buyer\" \"npm run web\"",
    "setup:topics": "npm run topics --workspace=scripts --",
    "setup:token": "npm run token --workspace=scripts",
    "setup:trust": "npm run trust --workspace=scripts --",
    "setup:register": "npm run register --workspace=scripts --",
    "lint": "eslint packages scripts --ext .ts",
    "setup:buyer": "npm run buyer --workspace=scripts --",
    "audit": "npm run cli --workspace=packages/audit --",
    "auditor": "SELLER_ROLE=auditor npm run dev --workspace=packages/seller",
    "setup:auditor": "npm run auditor --workspace=scripts --",
    "web": "npm run dev --workspace=packages/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@hiero-ledger/sdk": "2.85.0"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.85.0"
  }
}
